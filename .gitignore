# ─── Secrets ──────────────────────────────
.env
*.env
.env.*
# The backend keys live in a file literally named `env` (no leading dot), so the
# `.env` pattern above does NOT catch it and the `env/` dir pattern below only
# matches directories. Ignore the exact path so the plaintext GROQ / NewsAPI
# keys can never be staged by accident.
cybersecurity_friend/env
# Android signing material, if a release key is ever added.
*.jks
*.keystore
google-services.json

# ─── Python ──────────────────────────────
__pycache__/
*.pyc
*.pyo
*.egg-info/

# ─── Virtual Environments ────────────────
.venv/
venv/
env/

# ─── FAISS Index (build artifact) ────────
faiss_index/

# ─── IDE / Editor ────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── OS Files ────────────────────────────
.DS_Store
Thumbs.db

# ─── Stale local copy of the phishsense project ───
# Was recorded as a submodule gitlink with no .gitmodules, so a fresh clone got an
# empty directory it could never populate. The real repository lives at
# github.com/VIPULCODEX/phishsense and should be consumed from there.
project/

# ─── Encrypted context sync ───────────────────────
# These travel between machines inside context.enc (AES-256) rather than in
# plaintext. context.enc itself IS committed — it is unreadable without the
# passphrase, including to GitHub. See scripts/context.sh.
CLAUDE.md
ARCHITECTURE.md

# ─── Local-only docs (keep locally, not on GitHub) ─
PROJECT_LOG.txt
README.md
ROLLBACK_GUIDE.md

# ─── Mobile / Flutter ────────────────────
cyber_intel_app/.dart_tool/
cyber_intel_app/build/
cyber_intel_app/.flutter-plugins
cyber_intel_app/.flutter-plugins-dependencies
cyber_intel_app/.packages
# pubspec.lock is intentionally NOT ignored. It is an application, not a library,
# and the lockfile is what makes two machines (and CI) resolve the same plugin
# versions. Ignoring it meant every build was free to pick different transitive
# dependencies, which is a debugging nightmare that only shows up as "works on
# my machine". Commit it after the first `flutter pub get`.


# ─── Passphrase file for non-interactive packing (never commit) ───
.passphrase
